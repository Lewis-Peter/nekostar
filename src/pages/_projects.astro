---
import BaseLayout from '../layouts/BaseLayout.astro';

// 这一页连同导航里的「项目」一起停用（文件名前缀 _ 表示不出路由）。
// 原来那三张卡（Cardputer Chat / DroneStitch / 内核补丁）url 全是 null，
// 说了三个项目却一个都点不进去，读者拿到的只是三句自我介绍。
// 等真有仓库或详情页了，往 projects 里加回条目、去掉文件名前缀、
// 把 BaseLayout 的导航项恢复即可——下面的卡片结构原样留着。

type Project = {
  /** 为 null 表示还没有可以指向的仓库或详情页，卡片会渲染成不可点的说明文字 */
  url: string | null;
  name: string;
  nameEn?: string;
  type: string;
  typeEn: string;
  description: string;
  descriptionEn: string;
  status: string;
  statusEn: string;
};

const projects: Project[] = [];
---

<BaseLayout title="项目" description="硬件、安全和 Linux 内核相关项目。">
  <div class="shell page-intro">
    <p class="eyebrow">PROJECTS</p>
    <h1 data-i18n data-zh="做过的东西" data-en="Things I have built">做过的东西</h1>
    <p data-i18n data-zh="一些从想法走到可运行代码的项目。" data-en="Projects that made it from an idea to running code.">一些从想法走到可运行代码的项目。</p>
  </div>
  <section class="shell project-grid" aria-label="项目列表">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-card__top">
          <span class="status-badge" data-i18n data-zh={project.status} data-en={project.statusEn}>{project.status}</span>
        </div>
        <p class="project-card__type" data-i18n data-zh={project.type} data-en={project.typeEn}>{project.type}</p>
        <h2 data-i18n data-zh={project.name} data-en={project.nameEn ?? project.name}>{project.name}</h2>
        <p data-i18n data-zh={project.description} data-en={project.descriptionEn}>{project.description}</p>
        {/* 没有 url 就什么都不渲染：写一行「待补充」等于在每张卡上盖一个未完工的章，
            读者得到的信息还不如留白。等真有仓库或详情页了链接自然会出现。 */}
        {project.url && (
          <a href={project.url} aria-label={`查看 ${project.name} 项目`}><span data-i18n data-zh="项目详情" data-en="Project details">项目详情</span> <span aria-hidden="true">↗</span></a>
        )}
      </article>
    ))}
  </section>
  {projects.length === 0 && (
    <div class="shell">
      <p class="empty-note" data-i18n data-zh="还没有可以公开的项目。" data-en="No projects to show yet.">还没有可以公开的项目。</p>
    </div>
  )}
</BaseLayout>
