---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';
---

{/* 静态站只有一个 404 页面兜住所有路径，没法按语言分发，
    所以中英两句并排放着，谁进来都看得懂。altPath 传 null：
    这页不该被收录，也没有「另一语言版本」可言。 */}
<BaseLayout lang="zh" title={t('zh', 'notFound.title')} description={t('zh', 'notFound.description')} noindex altPath={null}>
  <div class="shell listing-page not-found">
    <p class="eyebrow">404</p>
    <h1>{t('zh', 'notFound.heading')}</h1>
    <p>{t('zh', 'notFound.body')}</p>
    <p lang="en">{t('en', 'notFound.heading')}. {t('en', 'notFound.body')}</p>
    <div class="not-found__links">
      <a href="/">{t('zh', 'notFound.home')}</a>
      <a href="/posts/">{t('zh', 'notFound.posts')}</a>
      <a href="/en/" lang="en">English</a>
    </div>
  </div>
</BaseLayout>
