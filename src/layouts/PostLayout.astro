---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import ApiPromo from '../components/ApiPromo.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  summary: string;
  readingMinutes: number;
  apiNote?: boolean;
}

const { title, date, tags, summary, readingMinutes, apiNote = false } = Astro.props;
---

<BaseLayout title={title} description={summary} ogType="article" publishedTime={date} tags={tags}>
  <div class="shell post-shell">
    <article class="post">
      <header class="post-header">
        <a class="post-header__back" href="/">← <span data-i18n data-zh="返回文章列表" data-en="Back to posts">返回文章列表</span></a>
        <h1>{title}</h1>
        <div class="post-header__meta">
          <time datetime={date.toISOString()} data-localized-date>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span><span data-i18n data-zh="约" data-en="About">约</span> {readingMinutes} <span data-i18n data-zh="分钟阅读" data-en="min read">分钟阅读</span></span>
        </div>
        <TagList tags={tags} />
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="post-footer">
        {apiNote && <ApiPromo />}
        <Giscus />
      </footer>
    </article>
  </div>
</BaseLayout>
