---
import { localizePath, t, DEFAULT_LANG, type Lang } from '../lib/i18n';

interface Props {
  tags: string[];
  lang?: Lang;
}

const { tags, lang = DEFAULT_LANG } = Astro.props;
---

<ul class="tag-list" aria-label={t(lang, 'tag.aria')}>
  {tags.map((tag) => (
    <li><a href={localizePath(lang, `/tags/${encodeURIComponent(tag)}/`)}>{tag}</a></li>
  ))}
</ul>
