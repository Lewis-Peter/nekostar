---
import { GISCUS, GISCUS_THEME_URLS, giscusThemeUrl } from '../site.config';
import { t, DEFAULT_LANG, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;

// 四项缺一不可，少任何一项 giscus 都会拿到无效配置
const configured = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.category && GISCUS.categoryId);

// mapping 仍然是 pathname，所以中英两版各有各的讨论帖。换成 specific + slug
// 能让两版共用一个帖子，但会把中文版已有的评论甩掉，不值当。
const giscusLang = lang === 'en' ? 'en' : 'zh-CN';
---

<section class="comments" aria-labelledby="comments-title" data-giscus-theme-urls={JSON.stringify(GISCUS_THEME_URLS)} data-giscus-lang={giscusLang}>
  <h2 id="comments-title">{t(lang, 'comments.title')}</h2>
  <p class="comments__hint">{t(lang, 'comments.hint')}</p>
  {configured && (
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={GISCUS.repo}
    data-repo-id={GISCUS.repoId}
    data-category={GISCUS.category}
    data-category-id={GISCUS.categoryId}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme={giscusThemeUrl('system')}
    data-lang={giscusLang}
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
  <script is:inline>
    (() => {
      const ORIGIN = 'https://giscus.app';
      const section = document.currentScript?.closest('.comments');
      if (!section) return;

      // iframe 刚插进 DOM 时还停在 about:blank，此时 postMessage 指定 giscus.app
      // 作为 targetOrigin 会被浏览器拒绝（报 origin 不匹配），配置就丢了。
      // 所以先排队，等 giscus 自己发来第一条消息（说明它真的加载好了）再统一发送。
      let ready = false;
      const queue = [];

      const post = (config) => {
        const frame = section.querySelector('iframe.giscus-frame');
        frame?.contentWindow?.postMessage({ giscus: { setConfig: config } }, ORIGIN);
      };

      window.addEventListener('message', (event) => {
        if (event.origin !== ORIGIN || ready) return;
        ready = true;
        while (queue.length) post(queue.shift());
      });

      // 暴露给 SiteControls：切换主题/语言时调用，未就绪会自动排队
      window.__giscusSetConfig = (config) => {
        if (ready) post(config);
        else queue.push(config);
      };

      // 主题地址从自己的 data 属性读，不依赖 SiteControls 挂的全局函数：
      // 那段脚本在拿不到控件按钮时会提前 return，定义全局的语句在 return 之后，
      // 页眉结构一改这里就会静默失效。两边各读各的构建期配置，互不牵连。
      const themeUrls = JSON.parse(section.dataset.giscusThemeUrls);
      const themeUrl = (theme) => themeUrls[theme] ?? themeUrls.system;

      const root = document.documentElement;
      // 自定义主题由 giscus 的 iframe 从公网 HTTPS 地址加载；astro dev 的 localhost
      // 对它不可达，因而本地评论区退回无主题样式是预期行为。
      window.__giscusSetConfig({
        lang: section.dataset.giscusLang,
        theme: themeUrl(root.dataset.theme)
      });
    })();
  </script>
  )}
  {!configured && (
    <p class="comments__pending" data-pending>{t(lang, 'comments.pending')}</p>
  )}
</section>
