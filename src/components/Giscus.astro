---
import { GISCUS } from '../site.config';

// 四项缺一不可，少任何一项 giscus 都会拿到无效配置
const configured = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.category && GISCUS.categoryId);
---

<section class="comments" aria-labelledby="comments-title">
  <h2 id="comments-title" data-i18n data-zh="讨论" data-en="Discussion">讨论</h2>
  <p class="comments__hint" data-i18n data-zh="欢迎补充、勘误或分享你的实践经验。" data-en="Corrections, additions, and field notes are always welcome.">欢迎补充、勘误或分享你的实践经验。</p>
  {configured && (
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={GISCUS.repo}
    data-repo-id={GISCUS.repoId}
    data-category={GISCUS.category}
    data-category-id={GISCUS.categoryId}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
  <script is:inline>
    (() => {
      const ORIGIN = 'https://giscus.app';
      const section = document.currentScript?.closest('.comments');
      if (!section) return;

      // iframe 刚插进 DOM 时还停在 about:blank，此时 postMessage 指定 giscus.app
      // 作为 targetOrigin 会被浏览器拒绝（报 origin 不匹配），配置就丢了。
      // 所以先排队，等 giscus 自己发来第一条消息（说明它真的加载好了）再统一发送。
      let ready = false;
      const queue = [];

      const post = (config) => {
        const frame = section.querySelector('iframe.giscus-frame');
        frame?.contentWindow?.postMessage({ giscus: { setConfig: config } }, ORIGIN);
      };

      window.addEventListener('message', (event) => {
        if (event.origin !== ORIGIN || ready) return;
        ready = true;
        while (queue.length) post(queue.shift());
      });

      // 暴露给 SiteControls：切换主题/语言时调用，未就绪会自动排队
      window.__giscusSetConfig = (config) => {
        if (ready) post(config);
        else queue.push(config);
      };

      const root = document.documentElement;
      window.__giscusSetConfig({
        lang: root.dataset.lang === 'en' ? 'en' : 'zh-CN',
        theme: root.dataset.theme || 'preferred_color_scheme'
      });
    })();
  </script>
  )}
  {!configured && (
    <p class="comments__pending" data-pending data-i18n data-zh="评论区还没配置（见 src/site.config.ts 的 GISCUS）。" data-en="Comments are not configured yet (see GISCUS in src/site.config.ts).">评论区还没配置（见 src/site.config.ts 的 GISCUS）。</p>
  )}
</section>
