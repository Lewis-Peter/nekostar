---
import { GISCUS_THEME_URLS } from '../site.config';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** 另一语言的同一页面地址，由 BaseLayout 算好 */
  switchHref: string;
}

const { lang, switchHref } = Astro.props;

// 主题按钮的文案在客户端切换时也要更新，所以整组交给脚本，不走服务端 t()
const themeCopy = {
  labels: {
    system: t(lang, 'controls.theme.system'),
    light: t(lang, 'controls.theme.light'),
    dark: t(lang, 'controls.theme.dark')
  },
  prefix: t(lang, 'controls.theme.prefix'),
  separator: lang === 'zh' ? '：' : ': '
};
---

<div
  class="site-controls"
  role="group"
  aria-label={t(lang, 'controls.aria')}
  data-giscus-theme-urls={JSON.stringify(GISCUS_THEME_URLS)}
  data-theme-copy={JSON.stringify(themeCopy)}
>
  <button
    class="preference-control"
    type="button"
    data-theme-toggle
    aria-label={`${themeCopy.prefix}${themeCopy.separator}${themeCopy.labels.system}`}
    title={`${themeCopy.prefix}${themeCopy.separator}${themeCopy.labels.system}`}
  >
    <span class="preference-control__icon" data-theme-icon aria-hidden="true">◐</span>
    <span data-theme-label>{themeCopy.labels.system}</span>
  </button>
  {/* 语言切换是真的换页面：两种语言各有一套构建好的 HTML，
      靠 JS 就地改文案的话，搜索引擎和不执行脚本的读者都拿不到英文内容。 */}
  <a
    class="preference-control preference-control--language"
    href={switchHref}
    hreflang={lang === 'zh' ? 'en' : 'zh-CN'}
    aria-label={t(lang, 'controls.language.action')}
    title={t(lang, 'controls.language.action')}
  >
    <span>{t(lang, 'controls.language.label')}</span>
  </a>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const controls = document.querySelector('.site-controls');
    const themeButton = controls?.querySelector('[data-theme-toggle]');
    if (!(themeButton instanceof HTMLButtonElement)) return;

    const themeOrder = ['system', 'light', 'dark'];
    const themeIcons = { system: '◐', light: '☼', dark: '☾' };
    const copy = JSON.parse(controls.dataset.themeCopy);

    const readTheme = () => {
      try {
        const saved = localStorage.getItem('wiki-theme');
        return themeOrder.includes(saved) ? saved : 'system';
      } catch {
        return 'system';
      }
    };

    const themeUrls = JSON.parse(controls.dataset.giscusThemeUrls);
    const giscusThemeUrl = (theme) => themeUrls[theme] ?? themeUrls.system;

    // 由 Giscus.astro 提供，内部会处理 iframe 尚未就绪时的排队。
    // 非文章页没有评论区，此时函数不存在，直接跳过。
    const updateGiscus = (settings) => window.__giscusSetConfig?.(settings);

    const applyTheme = (theme, persist = true) => {
      if (theme === 'system') delete root.dataset.theme;
      else root.dataset.theme = theme;
      if (persist) {
        try { localStorage.setItem('wiki-theme', theme); } catch {}
      }

      const label = copy.labels[theme];
      const accessibleLabel = `${copy.prefix}${copy.separator}${label}`;
      const icon = themeButton.querySelector('[data-theme-icon]');
      const text = themeButton.querySelector('[data-theme-label]');
      if (icon) icon.textContent = themeIcons[theme];
      if (text) text.textContent = label;
      themeButton.setAttribute('aria-label', accessibleLabel);
      themeButton.title = accessibleLabel;
      updateGiscus({ theme: giscusThemeUrl(theme) });
    };

    themeButton.addEventListener('click', () => {
      const current = readTheme();
      applyTheme(themeOrder[(themeOrder.indexOf(current) + 1) % themeOrder.length]);
    });

    // 首屏那段内联脚本只负责把 data-theme 提前打上（避免闪白），
    // 按钮文案还停在服务端渲染的「自动」，这里补一次同步。
    applyTheme(readTheme(), false);
  })();
</script>
